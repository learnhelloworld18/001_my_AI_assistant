# Template for .env:  cp .env.example .env
# .env is gitignored, never commit it.
#   1. ISSUED       a service gives you these
#   2. SETTINGS     not secret, just per-machine
#   3. SELF-CHOSEN  you generate these; don't rotate (see warnings)

# --- 1. ISSUED ---

# Web search for research_agent. https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here

# Langfuse SDK auth. From the Langfuse UI > project settings.
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# --- 2. SETTINGS ---

OLLAMA_HOST=http://localhost:11434

# Must match the port in docker-compose.langfuse.yml
LANGFUSE_HOST=http://localhost:3000

# --- 3. SELF-CHOSEN (read by docker-compose, not the app) ---

# Postgres password.  openssl rand -hex 16
# hex not base64: it goes inside a connection URL.
# Rotating breaks the connection - Postgres only reads this on first init.
LANGFUSE_DB_PASSWORD=generate_with_openssl_rand_hex_16

# Signs Langfuse session cookies.  openssl rand -base64 32
# Rotating logs you out.
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Hashes stored API keys.  openssl rand -base64 32
# Rotating invalidates the two keys above.
LANGFUSE_SALT=generate_with_openssl_rand_base64_32
